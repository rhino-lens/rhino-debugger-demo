<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot 4.0.8 manages Spring Framework 7.0.9 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>io.github.rhino-lens</groupId>
  <artifactId>rhino-debugger-demo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>rhino-debugger-demo</name>
  <description>Line-by-line debugger for scripts run on batik-js-lens-base (Rhino 1.6R5), in the browser</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Byte-identical rebuild of org.apache.xmlgraphics:batik-js:1.7 -->
    <dependency>
      <groupId>io.github.rhino-lens</groupId>
      <artifactId>batik-js-lens-base</artifactId>
      <version>1.7</version>
    </dependency>
    <!-- Observability: which rule and line changed which Java property, old -> new, service calls -->
    <dependency>
      <groupId>io.github.rhino-lens</groupId>
      <artifactId>batik-js-lens</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
